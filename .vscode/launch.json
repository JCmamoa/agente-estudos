{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ADK Web (Agente Estudos)",
      "type": "debugpy",
      "request": "launch",
      "module": "google.adk.cli",
      "args": [
        "web",
        "--allow_origins=*",
        "--port=8080",
        "."
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
